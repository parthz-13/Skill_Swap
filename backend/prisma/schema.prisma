generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int      @id @default(autoincrement())
  name           String
  email          String   @unique
  password       String
  bio            String?  @db.Text
  skillsOffered  String?  @db.Text 
  skillsWanted   String?  @db.Text 
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("users")
}